# ---------- REQUIRED for live rooms on Vercel ----------
# Upstash Redis (Vercel Marketplace → Storage → Upstash for Redis → Connect to project).
# Vercel injects either pair automatically; both names are supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# The Mahjong Rule Assistant is built in and free — no AI keys are needed or used.

# ---------- OPTIONAL ----------
# Fixed public URL for QR codes (otherwise the current page origin is used).
NEXT_PUBLIC_SITE_URL=
# Local testing only: use a JSON file store instead of Redis when running `next start`.
# (`npm run dev` uses it automatically when no Redis is configured.) Never set on Vercel.
# MT_DEV_FILE_STORE=1
